@model Supplier

<h2>Add Supplier</h2>
@using (Html.BeginForm("Create", "Supplier", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false)
    <p>
        @Html.LabelFor(model => model.Name)<br />
        @Html.TextBoxFor(model => model.Name, new { required = "required" })
    </p>
    <p>
        @Html.LabelFor(model => model.Phone)<br />
        @Html.TextBoxFor(model => model.Phone, new { required = "required" })
    </p>
    <p>
        @Html.LabelFor(model => model.Email)<br />
        @Html.TextBoxFor(model => model.Email, new { type = "email", required = "required" })
    </p>
    <button type="submit">Save</button>
}
<p>@Html.ActionLink("Back", "Index")</p>
