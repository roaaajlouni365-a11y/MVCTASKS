@{
    Layout = null;
    string[] products = { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate" };
    string[] suppliers = { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company", "Fresh Food Company", "Daily Supplies Company" };
    int[] quantities = { 100, 20, 50, 0, 30 };
    string[] statuses = { "Available", "Low Stock", "Available", "Out of Stock", "Available" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supply Status - University Cafeteria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/cafeteria.css" asp-append-version="true" />
</head>
<body class="status-layout">
    <main class="container page-content">
        <p class="eyebrow">University Cafeteria / Inventory</p>
        <h1>Supply Status</h1>
        <p class="intro">A clear view of our cafeteria supplies and current stock levels.</p>
        <div class="info-card">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <caption class="caption-top">Current stock for all five cafeteria products</caption>
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Number</th>
                            <th scope="col">Product Name</th>
                            <th scope="col">Supplier</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < products.Length; i++)
                        {
                            <tr>
                                <th scope="row">@(i + 1)</th>
                                <td>@products[i]</td>
                                <td>@suppliers[i]</td>
                                <td>@quantities[i]</td>
                                <td>
                                    @if (statuses[i] == "Available")
                                    {
                                        <span class="badge bg-success">@statuses[i]</span>
                                    }
                                    else if (statuses[i] == "Low Stock")
                                    {
                                        <span class="badge bg-warning text-dark">@statuses[i]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@statuses[i]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <a class="btn btn-outline-dark mt-4" asp-controller="Cafeteria" asp-action="Index">&larr; Back to cafeteria</a>
    </main>
    <footer class="page-footer">
        <div class="container">&copy; 2026 University Cafeteria &middot; Supply status</div>
    </footer>
</body>
</html>