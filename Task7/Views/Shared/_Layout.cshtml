<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Cafeteria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" href="/Home/Index">Cafeteria System</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            @Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link text-dark" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Categories", "Index", "Category", null, new { @class = "nav-link text-dark fw-bold" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Suppliers", "Index", "Supplier", null, new { @class = "nav-link text-dark fw-bold" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Products", "Index", "Product", null, new { @class = "nav-link text-dark fw-bold" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Employees", "Index", "Employee", null, new { @class = "nav-link text-dark fw-bold" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Orders", "Index", "Order", null, new { @class = "nav-link text-dark fw-bold" })
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>