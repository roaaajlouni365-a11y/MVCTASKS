@model IEnumerable<Order1>
<h1>Orders</h1>
<p>@Html.ActionLink("Add New Order", "Create", "Order", null, new { @class = "btn btn-primary" })</p>
<table class="table table-bordered mt-3">
    <thead><tr><th>Id</th><th>Customer Name</th><th>Order Date</th><th>Total Price</th><th>Status</th><th>Employee Id</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.Id</td><td>@item.CustomerName</td><td>@item.OrderDate</td><td>@item.TotalPrice</td><td>@item.Status</td><td>@item.EmployeeId</td>
                <td>@Html.ActionLink("Edit", "Edit", new { id = item.Id }) | @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @using (Html.BeginForm("Delete", "Order", new { id = item.Id }, FormMethod.Post, true, new { style = "display:inline;" }))
                    { <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this order?');">Delete</button> }
                </td>
            </tr>
        }
    </tbody>
</table>
