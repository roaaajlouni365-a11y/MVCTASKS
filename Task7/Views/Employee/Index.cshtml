@model IEnumerable<Employee1>
@{ var counts = ViewBag.OrderCounts as Dictionary<int, int>; }
<h1>Employees</h1>
<p>@Html.ActionLink("Add New Employee", "Create", "Employee", null, new { @class = "btn btn-primary" })</p>
<table class="table table-bordered mt-3">
    <thead><tr><th>Id</th><th>Name</th><th>Phone</th><th>Email</th><th>Position</th><th>Salary</th><th>Hire Date</th><th>Orders Count</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.Id</td><td>@item.Name</td><td>@item.phone</td><td>@item.email</td><td>@item.position</td><td>@item.Salary</td><td>@item.HireData</td>
                <td>@(counts != null && counts.ContainsKey(item.Id) ? counts[item.Id] : 0)</td>
                <td>@Html.ActionLink("Edit", "Edit", new { id = item.Id }) | @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @using (Html.BeginForm("Delete", "Employee", new { id = item.Id }, FormMethod.Post, true, new { style = "display:inline;" }))
                    { <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this employee?');">Delete</button> }
                </td>
            </tr>
        }
    </tbody>
</table>
