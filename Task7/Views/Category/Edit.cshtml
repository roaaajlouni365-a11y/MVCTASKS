@model UniversityCafeteriaManagement1.Models.Category1

@{
    ViewData["Title"] = "Edit Category";
}

<h2 class="mb-4">Edit Category</h2>

@using (Html.BeginForm("Edit", "Category", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    
    <!-- هذه الخطوة ضرورية جداً لحفظ الـ ID الخاص بالتصنيف المخفي -->
    @Html.HiddenFor(m => m.Id)

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Name, new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-4">
        @Html.LabelFor(m => m.Description, new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
    </div>

    <div>
        <button type="submit" class="btn btn-primary me-2">Save Changes</button>
        @Html.ActionLink("Back to List", "Index", "Category", null, new { @class = "btn btn-secondary" })
    </div>
}