@model UniversityCafeteriaManagement1.Models.Supplier1

@{
    ViewData["Title"] = "Supplier Details";
}

<h2 class="mb-4">Supplier Details</h2>

<div class="card shadow-sm p-4 mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Name)</dd>

        <dt class="col-sm-3 fw-bold mt-3">@Html.DisplayNameFor(m => m.Phone)</dt>
        <dd class="col-sm-9 mt-3">@Html.DisplayFor(m => m.Phone)</dd>

        <dt class="col-sm-3 fw-bold mt-3">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-sm-9 mt-3">@Html.DisplayFor(m => m.Email)</dd>

        <dt class="col-sm-3 fw-bold mt-3">@Html.DisplayNameFor(m => m.Address)</dt>
        <dd class="col-sm-9 mt-3">@Html.DisplayFor(m => m.Address)</dd>
    </dl>
</div>

<div>
    @Html.ActionLink("Edit", "Edit", "Supplier", new { id = Model.Id }, new { @class = "btn btn-primary me-2" })
    @Html.ActionLink("Back to List", "Index", "Supplier", null, new { @class = "btn btn-secondary" })
</div>