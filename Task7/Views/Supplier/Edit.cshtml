@model UniversityCafeteriaManagement1.Models.Supplier1

@{
    ViewData["Title"] = "Edit Supplier";
}

<h2 class="mb-4">Edit Supplier</h2>

@using (Html.BeginForm("Edit", "Supplier", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Name, new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Phone, new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", type = "number" })
        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Email, new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-4">
        @Html.LabelFor(m => m.Address, new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
    </div>

    <div>
        <button type="submit" class="btn btn-primary me-2">Save Changes</button>
        @Html.ActionLink("Back to List", "Index", "Supplier", null, new { @class = "btn btn-secondary" })
    </div>
}